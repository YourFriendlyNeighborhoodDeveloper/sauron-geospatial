# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Contact address sent in the User-Agent to NWS and Nominatim (both ask for one).
SAURON_CONTACT_EMAIL=

# Dashboard and API protection. Required before listening on anything but loopback.
SAURON_DASHBOARD_USER=sauron
SAURON_DASHBOARD_PASSWORD=
SAURON_API_TOKEN=

# Docker Compose publishes the dashboard on 127.0.0.1 only, so it allows an
# unauthenticated dashboard by default. Set to 0 once a password is configured.
SAURON_ALLOW_UNAUTHENTICATED=1

# Paid Open-Meteo key. Without it the free, non-commercial endpoint is used.
OPEN_METEO_API_KEY=

# Optional outbound proxy for the app container.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=kafka,prometheus,grafana,localhost,127.0.0.1
